# Copy to .env to override any default (all keys optional). Relative paths resolve against this Wordcloud/ folder.
# Loaded by python-dotenv: https://github.com/theskumar/python-dotenv

# Vault root that the source paths below are relative to
VAULT_DIR=..
# Individual notes to include (comma-separated)
SOURCE_FILES=Home.md,Exocortex.md,About me and my experience.md
# Folders whose top-level *.md notes are all included (comma-separated, non-recursive)
SOURCE_DIRS=Articles

# Output image and run logs
OUTPUT=wordcloud.png
LOG_DIR=logs

# Canvas size in pixels, max words drawn, and orientation/colour seed (same seed -> same image)
WIDTH=2000
HEIGHT=1200
MAX_WORDS=200
RANDOM_STATE=42

# Size of the most frequent word in px, and how strongly size follows frequency (0..1, ~ size = freq**rs).
# Lower either one to make the biggest words relatively smaller.
MAX_FONT_SIZE=180
RELATIVE_SCALING=0.5

# Extra hidden words: a one-word-per-line file
STOPWORDS_FILE=stopwords.txt
